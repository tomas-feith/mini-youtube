<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Same payload for both transports: the database and the
  settings file, nothing else. See backup_rules.xml for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mini_youtube.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="mini_youtube.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
