<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (fullBackupContent).

  The database holds the followed channels and which videos have been watched - the only
  things here that could not be rebuilt. Naming an <include> makes the rules exclusive, so
  caches (thumbnails, the player's WebView data) are left out without listing them.

  The database runs with a TRUNCATE journal rather than WAL (see VideoDatabase), so the one
  file is always complete and there is no sidecar to carry.
-->
<full-backup-content>
    <include domain="database" path="mini_youtube.db" />
</full-backup-content>
