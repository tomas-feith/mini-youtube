<?xml version="1.0" encoding="utf-8"?>
<!--
    A play button over a single line: a queue of videos, not a feed.

    Drawn inside the central 72x72 safe zone of the 108x108 adaptive-icon canvas, so no
    part of it is clipped by a round, squircle or squared mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Screen -->
    <path
        android:pathData="M32,30 L76,30 A8,8 0 0,1 84,38 L84,62 A8,8 0 0,1 76,70 L32,70 A8,8 0 0,1 24,62 L24,38 A8,8 0 0,1 32,30 Z"
        android:fillColor="#FF4E45" />

    <!-- Play mark, punched out in the background colour -->
    <path
        android:pathData="M48,40 L64,50 L48,60 Z"
        android:fillColor="#0F0F0F" />

    <!-- The backlog beneath it -->
    <path
        android:pathData="M28,78 L80,78"
        android:strokeColor="#F1F1F1"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
